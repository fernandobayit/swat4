# ─────────────────────────────────────────────────────────────
#  SWAT4 — Production environment configuration
#  Copy this file to .env and adjust values for your domain.
# ─────────────────────────────────────────────────────────────

# Samba DC Settings
# SAMBA_DC_HOST must point to the host where Samba AD is running.
#   - If SWAT4 runs in Docker on the SAME host as Samba AD, use host.docker.internal
#   - If Samba AD is on a different host, use its IP or hostname
SAMBA_DC_HOST=host.docker.internal
SAMBA_REALM=SWAT.LOCAL
SAMBA_DOMAIN=SWAT
SAMBA_BASE_DN=DC=swat,DC=local

# LDAP connection (use LDAPS port 636 in production if available)
LDAP_URL=ldap://host.docker.internal:389
SAMBA_ADMIN_USER=administrator
SAMBA_ADMIN_PASSWORD=ChangeThisPassword
SAMBA_DNS_FORWARDER=8.8.8.8

# Backend security — CHANGE THIS in production!
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Logging & Auth
SAMBA_LOG_PATH=/var/log/samba
ALLOWED_LOGIN_GROUPS=Domain Admins,Account Operators
TZ=America/Sao_Paulo