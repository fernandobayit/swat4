# SWAT4 Environment Configuration

# Samba DC Settings
SAMBA_DC_HOST=samba-dc
SAMBA_REALM=SWAT.LOCAL
SAMBA_DOMAIN=SWAT
SAMBA_BASE_DN=DC=swat,DC=local

# Important: StartTLS or LDAPS should be used in production.
# Active Directory usually listens on 636 for LDAPS
LDAP_URL=ldaps://samba-dc:636
SAMBA_ADMIN_USER=administrator
SAMBA_ADMIN_PASSWORD=change-this-admin-password
SAMBA_DNS_FORWARDER=8.8.8.8

# Backend Security (Change this in production!)
JWT_SECRET=generate-a-long-random-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Logging & Auth
SAMBA_LOG_PATH=/var/log/samba
ALLOWED_LOGIN_GROUPS=Domain Users,Account Operators
TZ=America/Sao_Paulo

# NetBird mesh (optional) — leave NETBIRD_SETUP_KEY empty to disable
NETBIRD_MANAGEMENT_URL=https://netbird.example.com:33073
NETBIRD_SETUP_KEY=
# NETBIRD_PEER_IP=100.80.0.2  # informational only
